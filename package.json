{
  "name": "zotero-github-links",
  "type": "module",
  "version": "1.0.3",
  "description": "Show GitHub repository links associated with Zotero items in the item details pane.",
  "config": {
    "addonName": "Zotero GitHub Links",
    "addonID": "github-links@huoyuuu.github.io",
    "addonRef": "zoterogithublinks",
    "addonInstance": "ZoteroGitHubLinks",
    "prefsPrefix": "extensions.zotero.githublinks"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/huoyuuu/zotero-github-links.git"
  },
  "author": "Huoyuuu",
  "bugs": {
    "url": "https://github.com/huoyuuu/zotero-github-links/issues"
  },
  "homepage": "https://github.com/huoyuuu/zotero-github-links",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "start": "zotero-plugin serve",
    "build": "zotero-plugin build && tsc --noEmit",
    "lint:check": "prettier --check . && eslint .",
    "lint:fix": "prettier --write . && eslint . --fix",
    "release": "zotero-plugin release",
    "test": "zotero-plugin test",
    "update-deps": "npm update --save"
  },
  "dependencies": {
    "zotero-plugin-toolkit": "^5.1.2"
  },
  "devDependencies": {
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.10.0",
    "@zotero-plugin/eslint-config": "^0.6.9",
    "chai": "^6.2.2",
    "eslint": "^9.39.2",
    "mocha": "^11.7.6",
    "prettier": "^3.8.4",
    "typescript": "^5.9.3",
    "zotero-plugin-scaffold": "^0.8.6",
    "zotero-types": "^4.1.2"
  },
  "prettier": {
    "printWidth": 80,
    "tabWidth": 2,
    "endOfLine": "lf",
    "overrides": [
      {
        "files": [
          "*.xhtml"
        ],
        "options": {
          "htmlWhitespaceSensitivity": "css"
        }
      }
    ]
  }
}
